node_modules/
dist/
.env
.env.*
!.env.example
.DS_Store
package-lock.json

# Machine-local agent state — worktrees are stale full checkouts, plus resume notes and local settings.
# Unanchored, for `.omc/`'s reason and one more: everything under `content/` is
# copied onto a user's disk and pinned in `content.lock`, so an agent that wrote
# its settings while sitting in `content/shell` would have published them.
.claude/
.cursor/
.codex/
.agents/
.vscode/
# ...except the one file at the root that is repo content rather than machine
# state: the editor's map from a manifest to the schema that judges it. A
# parent directory that stays excluded cannot have a file re-included out of
# it, so the root copy is re-included and then emptied by hand.
!/.vscode/
/.vscode/*
!/.vscode/settings.json

# Generated by packages/wizard prepack: the pin, and the manifests that travel with it.
packages/wizard/manifests/

# `npm pack` output in packages/wizard — the handover artefact, rebuilt on demand.
*.tgz

# Local working documents for the coding agents — never part of the public repo.
# None of these is anchored, for one reason: an agent whose working directory
# happened to be a package writes its notes there, and an anchored rule would not
# have caught them. A file that must be ignored everywhere and one that must be
# ignored only at the root do not belong in the same list — mixing the two forms
# is what makes a rule look like it works.
CLAUDE.md
AGENTS.md
PLAN.md
.omc/
.mcp.json

# A security audit names weak points by file and line, which makes it the one
# document that must never travel with the code it is about. Anchored to no
# directory and matched loosely on the name, so a copy written somewhere else,
# or under a name close to but not exactly these, is still caught.
#
# git's patterns are case-sensitive, and the name of a document is not: the two
# spellings below would have let `Security_Audit.md` and `SECURITY-AUDIT.md`
# straight through. So each letter that could go either way is written as a
# class. The separator is one too - an underscore, a hyphen, a space or nothing.
*[Ss][Ee][Cc][Uu][Rr][Ii][Tt][Yy][-_ ]*[Aa][Uu][Dd][Ii][Tt]*.[Mm][Dd]
*[Ss][Ee][Cc][Uu][Rr][Ii][Tt][Yy][Aa][Uu][Dd][Ii][Tt]*.[Mm][Dd]

# Local state written by the deploy and database tooling, plus whatever a test
# run leaves behind. None of it belongs to anyone but the machine that made it.
.vercel/
.supabase/
coverage/
*.log

# Extra banned patterns for check-publishable, private to one machine by design.
scripts/check-publishable.private.json
packages/wizard/content.lock
