# What never leaves this machine. Vercel builds from the uploaded sources and
# reads every variable from the project's environment (`vercel env`), so .env
# has no job there — uploading it would put the Chatfuel token and the Supabase
# secret key in the build container, and would let `vite build` read a local
# file instead of the project's own variables.
.env
.env.*

# `.env.*` does not cover `.envrc` — the pattern needs a literal dot after `env`,
# and that file exists for one thing: `export CHATFUEL_TOKEN=…`. Keys and the
# server log follow it out; with AUTH_RECOVERY_LINK_LOG on, the log is the only
# place a password recovery link is ever written.
.envrc
*.pem
*.key
*.log

# CLI working directories, local to the machine that ran them.
.vercel/
.supabase/

node_modules
dist
server/dist

# Not part of the deployed app.
# Deployment tooling has no job inside the deployment it creates.
scripts
.claude
.agents
chatfuel.manifest.json
supabase
Dockerfile
.dockerignore
**/*.test.ts
**/*.test.tsx
