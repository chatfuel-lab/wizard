{
  "name": "chatfuel-shell-app",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Chatfuel app: sidebar navigation hosting every installed module as an embeddable root under src/modules/<id>/. The dependencies below are exactly what the vendored src/vendor/{ui,api} and vendor/chatfuel-proxy/ sources need.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build -c vite.server.config.ts",
    "build:client": "vite build",
    "build:server": "vite build -c vite.server.config.ts",
    "codegen": "node scripts/codegen.mjs",
    "start": "node server/dist/entry.js",
    "deploy": "node scripts/deploy-vercel.mjs",
    "connect-git": "node scripts/connect-git.mjs",
    "check": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@supabase/supabase-js": "^2.112.4",
    "graphql": "16.14.2",
    "graphql-ws": "^6.2.1",
    "https-proxy-agent": "^9.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "undici": "^8.10.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
